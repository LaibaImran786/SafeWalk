
# Copy to .env (never commit .env). Used only by the optional AI briefing.
# Any OpenAI-compatible chat endpoint works (Ollama, vLLM, LM Studio, OpenRouter).
GEMMA_API_URL=http://localhost:11434/v1/chat/completions

# Verify the exact Gemma 4 model name your provider uses.
GEMMA_MODEL=gemma4

# Add your private API key to your local .env file only.
GEMMA_API_KEY=your_api_key_here
